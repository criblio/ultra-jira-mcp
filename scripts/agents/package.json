{
  "name": "jira-mcp-agents",
  "version": "1.0.0",
  "description": "AI agents for automated repository maintenance",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "security": "tsx src/agents/security-agent.ts",
    "bug-fix": "tsx src/agents/bug-fix-agent.ts",
    "pr-review": "tsx src/agents/pr-review-agent.ts"
  },
  "dependencies": {
    "ai": "^6.0.317",
    "@ai-sdk/google": "^3.0.139",
    "@ai-sdk/groq": "^3.0.79",
    "@ai-sdk/deepseek": "^2.0.77",
    "@ai-sdk/openai": "^3.0.134",
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@ai-sdk/anthropic": "^3.0.135",
    "@ai-sdk/mistral": "^3.0.77",
    "@ai-sdk/perplexity": "^3.1.8",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@octokit/rest": "^22.0.1",
    "ultra-mcp-toolkit": "github:criblio/ultra-mcp-toolkit#fd075e2d66c7b98583a72fc507e1d2b82ae0fd25",
    "zod": "^4.6.7",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^6.0.3",
    "tsx": "^4.22.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
